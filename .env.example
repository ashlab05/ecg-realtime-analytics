# ============================================================
# ECG Real-Time Analytics — Environment Configuration
# Copy to .env and adjust as needed:  cp .env.example .env
# ============================================================

# --- General ---
PROJECT_NAME=ecg-realtime-analytics
RANDOM_SEED=42

# --- Paths (relative to project root; override for custom layouts) ---
DATA_DIR=data
MODELS_DIR=models
LOGS_DIR=logs

# --- Dataset ---
# Place the MIT-BIH Arrhythmia feature CSV here (or set an absolute path)
ECG_DATASET_PATH=data/raw/MIT-BIH Arrhythmia Database.csv

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=ecg-events
KAFKA_TOPIC_PREDICTIONS=ecg-predictions
KAFKA_TOPIC_ERRORS=ecg-errors
KAFKA_CONSUMER_GROUP=ecg-analytics

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecg_analytics
POSTGRES_USER=ecg
POSTGRES_PASSWORD=ecg_secret
# SQLAlchemy URL (used by API + Spark). In Docker, host is "postgres".
DATABASE_URL=postgresql+psycopg2://ecg:ecg_secret@localhost:5432/ecg_analytics

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./spark-checkpoints/ecg
SPARK_TRIGGER_INTERVAL=5 seconds
SPARK_STREAM_BATCH_LOG=logs/streaming/batch_metrics.csv

# --- Model / Autoencoder ---
AE_THRESHOLD_PERCENTILE=95
AE_BATCH_SIZE=256
AE_EPOCHS=50
AE_LEARNING_RATE=0.001
