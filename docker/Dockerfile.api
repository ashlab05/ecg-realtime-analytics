# FastAPI inference/API service.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.2.2
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY ecg_core/ ecg_core/
COPY inference/ inference/
COPY api/ api/
COPY database/ database/
COPY streaming/ streaming/
COPY models/ models/

# Trained model artifacts are expected to be baked in or mounted.
# The service starts even without them (endpoints report models as not ready).
EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
